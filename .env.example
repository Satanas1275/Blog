PORT=3003
AUTH_TOKEN=change_me_to_a_long_random_secret
DB_PATH=./data/blog.db
UPLOADS_DIR=./public/uploads
LOGS_DIR=./logs

# Délai (minutes) sans nouvelle du now-playing avant de le considérer arrêté (heartbeat app ~5min,
# ce délai doit être plus grand pour tolérer un peu de latence réseau)
NOW_PLAYING_STALE_MINUTES=8

# Nom affiché sur le site (titre + en-tête)
APP_NAME=Bastian RIOT

# Sous-chemin de montage du site. "/" = racine. "/blog" = servi sur monsite.com/blog au lieu de monsite.com/
BASE_PATH=/

# Service d'analytics externe (optionnel) — voir README-web.md pour le contrat attendu.
ANALYTICS_EXTERNAL_URL=http://localhost:5055
ANALYTICS_EXTERNAL_TOKEN=change_me
# ANALYTICS_TO : on pousse chaque vue de page vers le service externe (POST {url}/events)
ANALYTICS_TO=false
# ANALYTICS_FROM : on va chercher des données chez le service externe pour les inclure dans /api/analytics/summary
ANALYTICS_FROM=false
